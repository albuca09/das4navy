                    <td>14.219</td>
                    <td>2021-11-01 18:12:04+00:00</td>
                  </tr>
                  <tr>
                    <td>north</td>
                    <td>0.429</td>
                    <td>16.530</td>
                    <td>2021-11-01 21:40:06+00:00</td>
